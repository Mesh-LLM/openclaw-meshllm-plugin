{
  "name": "openclaw-meshllm",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw model-provider plugin for MeshLLM client and serving-node modes",
  "license": "MIT",
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/src/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run test"
  },
  "dependencies": {
    "@meshllm/sdk": "file:../mesh-llm/sdk/node"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "openclaw": "2026.6.11",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.11"
  },
  "engines": {
    "node": ">=22.19"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "providers": [
      "meshllm"
    ],
    "compat": {
      "pluginApi": ">=2026.6.11",
      "minGatewayVersion": "2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.6.11",
      "pluginSdkVersion": "2026.6.11"
    }
  }
}
